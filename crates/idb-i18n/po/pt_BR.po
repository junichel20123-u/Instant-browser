msgid "diag.ServerPerConnectionLimit"
msgstr "O servidor limita cerca de {per_conn} por conexão; com {conns} conexões chegamos a {total}."

msgid "diag.LinkSaturated"
msgstr "Seu link é o gargalo (cerca de {link_est}): o servidor entregaria mais. Mais conexões não ajudariam."

msgid "diag.ServerAskedToWait"
msgstr "O servidor pediu para esperar {secs} (Retry-After). Reduzimos para {reduced_to} conexões."

msgid "diag.HtmlInsteadOfFile"
msgstr "O site devolveu uma página ({size}) em vez do arquivo. Provavelmente precisa de login. Reenvie pela extensão."

msgid "diag.RangeNotSupported"
msgstr "O servidor não permite baixar em partes; usando uma conexão. A retomada não será possível se a conexão cair."

msgid "diag.BdpExceedsRmem"
msgstr "O atraso até o servidor é alto e o buffer do seu sistema ({rmem_max}) limita a velocidade; seriam necessários {bdp}. Sugestão (requer administrador): ajustar net.ipv4.tcp_rmem."

msgid "diag.MirrorQuarantined"
msgstr "Um espelho entregou um arquivo diferente e foi ignorado: {url} ({why})."

msgid "diag.StalledConnectionReassigned"
msgstr "Uma conexão travou e o trecho foi passado para outra."

msgid "cli.connections_limit"
msgstr "Use -c auto (o programa decide) ou um número de 1 a {max}: {max} é o teto educado de conexões por servidor."

msgid "diag.ConnectionsAdjusted.up"
msgstr "Com {from} conexões o ganho foi de {gain}%; passando para {to}."

msgid "diag.ConnectionsAdjusted.down"
msgstr "A conexão extra não ajudou ({gain}%); voltando para {to}."

msgid "diag.ConnectionsAdjusted.stay"
msgstr "Mantendo {to} conexões: é o teto educado para este servidor."

msgid "cli.invalid_sha256"
msgstr "O valor de --sha256 deve ter 64 caracteres hexadecimais (0-9, a-f)."

msgid "cli.invalid_limit"
msgstr "Não entendi o --limit. Exemplos: 2M, 500k, 1.5MiB."

