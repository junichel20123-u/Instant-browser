msgid "diag.ServerPerConnectionLimit"
msgstr "The server limits about {per_conn} per connection; with {conns} connections we reach {total}."

msgid "diag.LinkSaturated"
msgstr "Your connection is the bottleneck (about {link_est}): the server could deliver more. More connections would not help."

msgid "diag.ServerAskedToWait"
msgstr "The server asked us to wait {secs} (Retry-After). We reduced to {reduced_to} connections."

msgid "diag.HtmlInsteadOfFile"
msgstr "The site returned a page ({size}) instead of the file. It probably needs a login. Resend it from the browser extension."

msgid "diag.RangeNotSupported"
msgstr "The server does not allow downloading in parts; using one connection. Resuming will not be possible if the connection drops."

msgid "diag.BdpExceedsRmem"
msgstr "The delay to the server is high and your system buffer ({rmem_max}) limits the speed; {bdp} would be needed. Suggestion (requires administrator): tune net.ipv4.tcp_rmem."

msgid "diag.MirrorQuarantined"
msgstr "A mirror delivered a different file and was ignored: {url} ({why})."

msgid "diag.StalledConnectionReassigned"
msgstr "A connection stalled and its part was handed to another one."

msgid "cli.connections_limit"
msgstr "The polite limit is {max} connections per server. Use -c between 1 and {max}."
